{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Extensions.Http.Resilience": "Warning",
        "Npgsql": "Warning",
        "Polly": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "TickPulse.Api.Auth.ApiKeyAuthenticationHandler": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Otel": {
    "Endpoint": "",
    "FlushSampleRatio": 0.1,
    "SampledRequestsPerSecond": 10
  },
  "Database": {
    "RunMigrationsOnStartup": true,
    "AllowGssEncryption": false,
    "MaxPoolSize": 20
  },
  "Admin": {
    "ApiKey": "",
    "MaxActiveSymbols": 20
  },
  "RateLimiting": {
    "PermitLimit": 300,
    "WindowSeconds": 60
  },
  "Ingestion": {
    "RotationInterval": "23:00:00",
    "BatchMaxSize": 5000,
    "BatchMaxDelay": "00:00:00.500",
    "ChannelCapacity": 100000,
    "ReconcileInterval": "00:00:30",
    "LeaderRetryInterval": "00:00:10",
    "LeaderCheckInterval": "00:00:05"
  },
  "Backfill": {
    "Enabled": false,
    "Depth": "182.00:00:00"
  }
}
