{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "RunMigrationsOnStartup": true
  },
  "RateLimiting": {
    "PermitLimit": 300,
    "WindowSeconds": 60
  },
  "Ingestion": {
    "RotationInterval": "23:00:00",
    "BatchMaxSize": 5000,
    "BatchMaxDelay": "00:00:00.500",
    "ChannelCapacity": 100000,
    "ReconcileInterval": "00:00:30",
    "LeaderRetryInterval": "00:00:10",
    "LeaderCheckInterval": "00:00:05"
  },
  "Backfill": {
    "Enabled": false,
    "Depth": "182.00:00:00"
  }
}
