# Copy to .env (git-ignored) to override the local defaults of docker-compose.yml.
# Every value below is the default that applies when the variable is not set.

# --- Database (timescale/timescaledb) ---
# Applied when the tickpulse-db volume is first created; `docker compose down -v` resets it.
POSTGRES_DB=tickpulse
POSTGRES_USER=tickpulse
POSTGRES_PASSWORD=tickpulse

# --- API ---
# Host address and port of the API and dashboard. 127.0.0.1 keeps it local; 0.0.0.0 exposes it to the LAN.
API_BIND=127.0.0.1
API_PORT=8080
# X-Api-Key for the admin endpoints. Use a long random value outside local development.
ADMIN_API_KEY=local-dev-key
# Subnet of the compose network; the API trusts CF-Connecting-IP only from peers inside it.
TICKPULSE_SUBNET=172.30.0.0/24
# OTLP endpoint. Empty switches the exporters off.
OTEL_ENDPOINT=http://otel-collector:4317
# Salt of the daily client-IP hash in logs. Empty means a random salt per process.
OTEL_IP_SALT=

# --- Observability profile (deploy/observability/README.md lists the rest) ---
# Applied on Grafana's first start only.
GRAFANA_ADMIN_PASSWORD=tickpulse-dev
GRAFANA_PORT=3000
