          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=\"tickpulse-api\"} | detected_level=~\"$level\" |~ \"(?i)$search\" | trace_id=~\"$trace_id.*\" [$__range]))",
          "queryType": "instant"
